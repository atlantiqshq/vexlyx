# Vexlyx Postfix master.cf (F4.1)
# ==========================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
#               (yes)   (yes)   (no)    (never) (100)
# ==========================================================================
smtp      inet  n       -       n       -       -       smtpd

# Server-side signatures (F5.31). Mail from authenticated clients on the submission port goes
# through the signature filter (the sigfilter pipe at the bottom of this file) and comes back in
# through pickup, where OpenDKIM signs it (non_smtpd_milters). DKIM is therefore computed AFTER the
# signature is added and stays valid. That is why submission has no milter of its own: it would
# sign too early and the added text would break the signature.
submission inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_reject_unlisted_recipient=no
  -o smtpd_client_restrictions=permit_sasl_authenticated,permit_mynetworks,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,permit_mynetworks,reject
  -o milter_macro_daemon_name=ORIGINATING
  -o smtpd_milters=
  -o content_filter=sigfilter:dummy

pickup    unix  n       -       n       60      1       pickup
  -o milter_macro_daemon_name=ORIGINATING
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd

# Signature filter (F5.31): reads the message on stdin, adds the sender's signature if one is
# enforced for them, and hands it back to Postfix with sendmail. Any problem delivers the message
# unchanged. -u= is the authenticated user, -f= the envelope sender; the "=" form keeps an empty
# value from shifting the arguments.
sigfilter unix  -       n       n       -       10      pipe
  flags=Rq user=sigfilter argv=/usr/local/bin/signature_filter.sh -u=${sasl_username} -f=${sender} -- ${recipient}
